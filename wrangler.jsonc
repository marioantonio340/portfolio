{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./build",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "portfolio.olivario.com.br/*",
      "zone_name": "olivario.com.br"
    }
  ]
}
